{
  "id": "animation",
  "kind": "plugin",
  "version": "1.3.9",
  "label": "UEFN Animation",
  "description": "IK retargeting with retarget-pose fixes, skeleton sockets, Level Sequence / AnimSequence authoring, sequence bake, additive AnimType for player overlays, Animated Mesh device playback, and custom-mesh NPC authoring (NPCCharacterDefinitions, AnimPresets, character Blueprints, physics assets) with no Content Browser clicks. Bundles the animation skill. Serial editor ops (one MCP call per turn).",
  "min_app_version": "1.0.655",
  "default_enabled": true,
  "secret_keys": [],
  "contributes": {
    "agent.tools": {
      "category": "animation",
      "tools": [
        "ik_retarget_capabilities",
        "list_skeleton_bones",
        "get_retarget_preset",
        "get_ik_rig_info",
        "get_ik_retargeter_info",
        "create_ik_rig_asset",
        "create_ik_retargeter_asset",
        "set_retarget_root",
        "add_retarget_chains",
        "remove_retarget_chains",
        "auto_map_retarget_chains",
        "get_retarget_pose_info",
        "create_retarget_pose",
        "set_current_retarget_pose",
        "set_retarget_pose_bone_rotation",
        "set_retarget_pose_root_offset",
        "retarget_animation",
        "retarget_animation_pipeline",
        "list_skeleton_sockets",
        "add_skeleton_socket",
        "get_skeletal_mesh_info",
        "remove_skeleton_socket",
        "anim_author_capabilities",
        "create_level_sequence",
        "add_sequence_binding",
        "add_transform_keys",
        "get_sequence_info",
        "create_anim_sequence",
        "set_anim_bone_keys",
        "get_anim_sequence_info",
        "set_anim_additive_type",
        "bake_sequence_to_anim",
        "animated_mesh_capabilities",
        "configure_animated_mesh",
        "npc_author_capabilities",
        "list_npc_definitions",
        "get_npc_definition_info",
        "create_physics_asset_for_mesh",
        "create_anim_preset",
        "set_anim_preset_slots",
        "create_character_blueprint",
        "create_npc_character_definition",
        "set_npc_definition_behavior",
        "set_npc_definition_look",
        "set_npc_spawner_definition"
      ],
      "intent_pattern": "\\b(anim|retarget|ik\\s*rig|skeleton|sequencer|level\\s*sequence|animated\\s*mesh|control\\s*rig|mixamo|additive|player\\s*anim|npc|npc\\s*def|character\\s*definition|anim\\s*preset|animpreset|character\\s*blueprint|cosmetic\\s*spawn|creature|animal|pet|quadruped|ecosystem)\\b",
      "plan_tools": [
        "ik_retarget_capabilities",
        "list_skeleton_bones",
        "list_skeleton_sockets",
        "get_skeletal_mesh_info",
        "get_retarget_preset",
        "get_ik_rig_info",
        "get_ik_retargeter_info",
        "get_retarget_pose_info",
        "anim_author_capabilities",
        "animated_mesh_capabilities",
        "get_sequence_info",
        "get_anim_sequence_info",
        "npc_author_capabilities",
        "list_npc_definitions",
        "get_npc_definition_info"
      ]
    },
    "walkthrough": {
      "id": "animation",
      "title": "Animation tools ready",
      "auto_start": "first_enable",
      "settings_tab": "Store",
      "steps": [
        {
          "target": "settings.store.root",
          "title": "Animation tools ready",
          "body": "Animation MCP tools and the animation skill are live. Ask the agent to retarget, author sequences, or inspect skeleton sockets.",
          "advance": "next",
          "mode": "rect"
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
